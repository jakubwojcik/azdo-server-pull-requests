{
  "name": "azdo-server-pull-requests",
  "displayName": "Azure DevOps Server Pull Requests",
  "description": "Review pull requests on an on-premises Azure DevOps Server.",
  "version": "0.0.1",
  "publisher": "jakubwojcik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakubwojcik/azdo-server-pull-requests"
  },
  "categories": [
    "SCM Providers"
  ],
  "engines": {
    "vscode": "^1.140.0",
    "node": ">=22.18"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Azure DevOps Server Pull Requests",
      "properties": {
        "azdoServerPullRequests.collectionUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "URL of the Azure DevOps Server Collection, e.g. `https://tfs.example.com/tfs/DefaultCollection`."
        },
        "azdoServerPullRequests.apiVersion": {
          "type": "string",
          "default": "7.0",
          "description": "REST api-version sent with every request."
        }
      }
    },
    "commands": [
      {
        "command": "azdoServerPullRequests.configureCollection",
        "title": "Configure Collection",
        "category": "Azure DevOps Server"
      },
      {
        "command": "azdoServerPullRequests.updatePat",
        "title": "Update PAT",
        "category": "Azure DevOps Server"
      },
      {
        "command": "azdoServerPullRequests.signOut",
        "title": "Sign out",
        "category": "Azure DevOps Server"
      },
      {
        "command": "azdoServerPullRequests.reply",
        "title": "Comment",
        "category": "Azure DevOps Server"
      },
      {
        "command": "azdoServerPullRequests.editComment",
        "title": "Edit",
        "category": "Azure DevOps Server",
        "icon": "$(edit)"
      },
      {
        "command": "azdoServerPullRequests.deleteComment",
        "title": "Delete",
        "category": "Azure DevOps Server",
        "icon": "$(trash)"
      },
      {
        "command": "azdoServerPullRequests.saveComment",
        "title": "Save",
        "category": "Azure DevOps Server"
      },
      {
        "command": "azdoServerPullRequests.cancelEdit",
        "title": "Cancel",
        "category": "Azure DevOps Server"
      },
      {
        "command": "azdoServerPullRequests.like",
        "title": "Like",
        "category": "Azure DevOps Server",
        "icon": "$(thumbsup)"
      },
      {
        "command": "azdoServerPullRequests.unlike",
        "title": "Unlike",
        "category": "Azure DevOps Server",
        "icon": "$(thumbsup-filled)"
      },
      {
        "command": "azdoServerPullRequests.resolveThread",
        "title": "Resolve",
        "category": "Azure DevOps Server",
        "icon": "$(check)"
      },
      {
        "command": "azdoServerPullRequests.reactivateThread",
        "title": "Reactivate",
        "category": "Azure DevOps Server",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "azdoServerPullRequests.changeThreadStatus",
        "title": "Change Status",
        "category": "Azure DevOps Server",
        "icon": "$(list-selection)"
      },
      {
        "command": "azdoServerPullRequests.approve",
        "title": "Approve",
        "category": "Azure DevOps Server",
        "icon": "$(check)"
      },
      {
        "command": "azdoServerPullRequests.approveWithSuggestions",
        "title": "Approve with suggestions",
        "category": "Azure DevOps Server"
      },
      {
        "command": "azdoServerPullRequests.waitForAuthor",
        "title": "Wait for author",
        "category": "Azure DevOps Server"
      },
      {
        "command": "azdoServerPullRequests.reject",
        "title": "Reject",
        "category": "Azure DevOps Server",
        "icon": "$(close)"
      },
      {
        "command": "azdoServerPullRequests.resetVote",
        "title": "Reset vote",
        "category": "Azure DevOps Server"
      },
      {
        "command": "azdoServerPullRequests.startGeneralThread",
        "title": "Start General Thread",
        "category": "Azure DevOps Server",
        "icon": "$(comment)"
      },
      {
        "command": "azdoServerPullRequests.openInBrowser",
        "title": "Open in Browser",
        "category": "Azure DevOps Server",
        "icon": "$(link-external)"
      },
      {
        "command": "azdoServerPullRequests.copyUrl",
        "title": "Copy URL",
        "category": "Azure DevOps Server"
      },
      {
        "command": "azdoServerPullRequests.refresh",
        "title": "Refresh",
        "category": "Azure DevOps Server",
        "icon": "$(refresh)"
      },
      {
        "command": "azdoServerPullRequests.previousThread",
        "title": "Previous Thread",
        "category": "Azure DevOps Server",
        "icon": "$(chevron-up)"
      },
      {
        "command": "azdoServerPullRequests.nextThread",
        "title": "Next Thread",
        "category": "Azure DevOps Server",
        "icon": "$(chevron-down)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azdoServerPullRequests",
          "title": "Azure DevOps Server Pull Requests",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "azdoServerPullRequests": [
        {
          "id": "azdoServerPullRequests.assigned",
          "name": "Assigned Pull Requests"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "azdoServerPullRequests.assigned",
        "contents": "Connect to your Azure DevOps Server Collection to review the Pull Requests assigned to you.\n[Configure Collection](command:azdoServerPullRequests.configureCollection)",
        "when": "azdoServerPullRequests.unconfigured"
      },
      {
        "view": "azdoServerPullRequests.assigned",
        "contents": "No active Pull Requests are assigned to you.",
        "when": "azdoServerPullRequests.loaded"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "azdoServerPullRequests.reply",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.editComment",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.deleteComment",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.saveComment",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.cancelEdit",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.resolveThread",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.reactivateThread",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.changeThreadStatus",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.approve",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.approveWithSuggestions",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.waitForAuthor",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.reject",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.resetVote",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.startGeneralThread",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.openInBrowser",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.copyUrl",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.like",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.unlike",
          "when": "false"
        },
        {
          "command": "azdoServerPullRequests.previousThread",
          "when": "resourceScheme == azdo-server-pr"
        },
        {
          "command": "azdoServerPullRequests.nextThread",
          "when": "resourceScheme == azdo-server-pr"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "azdoServerPullRequests.reply",
          "group": "inline",
          "when": "commentController == azdoServerPullRequests"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "azdoServerPullRequests.resolveThread",
          "group": "inline@1",
          "when": "commentController == azdoServerPullRequests && commentThread == unresolved"
        },
        {
          "command": "azdoServerPullRequests.reactivateThread",
          "group": "inline@1",
          "when": "commentController == azdoServerPullRequests && commentThread == resolved"
        },
        {
          "command": "azdoServerPullRequests.changeThreadStatus",
          "group": "inline@2",
          "when": "commentController == azdoServerPullRequests && commentThread"
        }
      ],
      "comments/comment/title": [
        {
          "command": "azdoServerPullRequests.like",
          "group": "inline@0",
          "when": "commentController == azdoServerPullRequests && comment =~ /,notLiked$/"
        },
        {
          "command": "azdoServerPullRequests.unlike",
          "group": "inline@0",
          "when": "commentController == azdoServerPullRequests && comment =~ /,liked$/"
        },
        {
          "command": "azdoServerPullRequests.editComment",
          "group": "inline@1",
          "when": "commentController == azdoServerPullRequests && comment =~ /^own,/"
        },
        {
          "command": "azdoServerPullRequests.deleteComment",
          "group": "inline@2",
          "when": "commentController == azdoServerPullRequests && comment =~ /^own,/"
        }
      ],
      "comments/comment/context": [
        {
          "command": "azdoServerPullRequests.saveComment",
          "group": "inline@1",
          "when": "commentController == azdoServerPullRequests"
        },
        {
          "command": "azdoServerPullRequests.cancelEdit",
          "group": "inline@2",
          "when": "commentController == azdoServerPullRequests"
        }
      ],
      "view/title": [
        {
          "command": "azdoServerPullRequests.refresh",
          "group": "navigation",
          "when": "view == azdoServerPullRequests.assigned"
        }
      ],
      "view/item/context": [
        {
          "command": "azdoServerPullRequests.approve",
          "group": "1_vote@1",
          "when": "view == azdoServerPullRequests.assigned && viewItem == pullRequest"
        },
        {
          "command": "azdoServerPullRequests.approveWithSuggestions",
          "group": "1_vote@2",
          "when": "view == azdoServerPullRequests.assigned && viewItem == pullRequest"
        },
        {
          "command": "azdoServerPullRequests.waitForAuthor",
          "group": "1_vote@3",
          "when": "view == azdoServerPullRequests.assigned && viewItem == pullRequest"
        },
        {
          "command": "azdoServerPullRequests.reject",
          "group": "1_vote@4",
          "when": "view == azdoServerPullRequests.assigned && viewItem == pullRequest"
        },
        {
          "command": "azdoServerPullRequests.resetVote",
          "group": "1_vote@5",
          "when": "view == azdoServerPullRequests.assigned && viewItem == pullRequest"
        },
        {
          "command": "azdoServerPullRequests.startGeneralThread",
          "group": "2_discuss@1",
          "when": "view == azdoServerPullRequests.assigned && viewItem =~ /^(draftP|p)ullRequest$/"
        },
        {
          "command": "azdoServerPullRequests.openInBrowser",
          "group": "3_share@1",
          "when": "view == azdoServerPullRequests.assigned && viewItem =~ /^(draftP|p)ullRequest$/"
        },
        {
          "command": "azdoServerPullRequests.copyUrl",
          "group": "3_share@2",
          "when": "view == azdoServerPullRequests.assigned && viewItem =~ /^(draftP|p)ullRequest$/"
        }
      ],
      "editor/title": [
        {
          "command": "azdoServerPullRequests.previousThread",
          "group": "navigation@1",
          "when": "resourceScheme == azdo-server-pr"
        },
        {
          "command": "azdoServerPullRequests.nextThread",
          "group": "navigation@2",
          "when": "resourceScheme == azdo-server-pr"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node --target=node22 --sourcemap",
    "watch": "npm run build -- --watch",
    "vscode:prepublish": "npm run build -- --minify",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.140.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
